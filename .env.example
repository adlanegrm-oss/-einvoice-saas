# Copiez ce fichier vers .env (jamais versionné) et remplacez TOUTES les valeurs.
# Générer un secret :  openssl rand -base64 48

# --- Secrets de signature des jetons (32 caractères minimum, différents par environnement) ---
JWT_SECRET_RECETTE=
JWT_SECRET_PREPROD=
JWT_SECRET_PROD=

# --- Comptes administrateur (10 caractères minimum) ---
ADMIN_EMAIL=admin@votre-domaine.fr
ADMIN_PASSWORD_RECETTE=
ADMIN_PASSWORD_PREPROD=
ADMIN_PASSWORD_PROD=

# --- URL publique (sert à fabriquer les liens de réinitialisation) ---
PUBLIC_BASE_URL_PROD=https://facturation.votre-domaine.fr

# --- E-mail sortant (obligatoire pour "mot de passe oublié" hors DEV) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Lancement local sans Docker (APP_ENV=DEV) : tout est optionnel ---
# ADMIN_PASSWORD=          # généré et affiché au démarrage si absent
# CLIENT_EMAIL=client@example.com
# CLIENT_PASSWORD=
# PORT=8080
# DATA_DIR=data
