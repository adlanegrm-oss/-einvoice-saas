+openapi: 3.1.0
+info:
+  title: E-Invoicing Gateway & Compliance API
+  description: Developer-first compliance, validation (EN 16931), and delivery gateway for ERP and financial software.
+  version: 1.0.0
+servers:
+  - url: https://api.einvoice-gateway.io/v1
+    description: Production Cluster
+  - url: https://sandbox.einvoice-gateway.io/v1
+    description: Deterministic Testing Environment
+paths:
+  /invoices/validate:
+    post:
+      summary: Validate an invoice payload against EN 16931 rules
+      description: Synchronously checks XML (UBL 2.1 / CII) against semantic and monetary rules without submitting to PDP.
+      security:
+        - ApiKeyAuth: []
+      requestBody:
+        required: true
+        content:
+          application/xml:
+            schema:
+              type: string
+              format: binary
+      responses:
+        '200':
+          description: Validation report
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ValidationReport'
+        '400':
+          description: Parser security rejection (XXE, oversized file, illegal DTD)
+  /invoices:
+    post:
+      summary: Ingest, enforce idempotency, and schedule delivery
+      parameters:
+        - name: Idempotency-Key
+          in: header
+          required: true
+          schema:
+            type: string
+            format: uuid
+        - name: X-Mock-Outcome
+          in: header
+          required: false
+          description: Sandbox deterministic override
+          schema:
+            type: string
+            enum: [PDP_ACCEPTED, PDP_REJECTED, PDP_TIMEOUT]
+      security:
+        - ApiKeyAuth: []
+      requestBody:
+        required: true
+        content:
+          application/xml:
+            schema:
+              type: string
+              format: binary
+      responses:
+        '202':
+          description: Ingestion accepted and committed to transactional outbox
+  /invoices/{id}/evidence:
+    get:
+      summary: Download complete cryptographic evidence package
+      security:
+        - ApiKeyAuth: []
+      parameters:
+        - name: id
+          in: path
+          required: true
+          schema:
+            type: string
+      responses:
+        '200':
+          description: Verified cryptographic audit ledger
+components:
+  securitySchemes:
+    ApiKeyAuth:
+      type: http
+      scheme: bearer
+      bearerFormat: APIKey
+  schemas:
+    ValidationReport:
+      type: object
+      properties:
+        valid:
+          type: boolean
+        syntax:
+          type: string
+        errors_count:
+          type: integer
+        results:
+          type: array
+          items:
+            type: object