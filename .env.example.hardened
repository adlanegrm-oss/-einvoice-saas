# Ne jamais versionner le fichier .env réel.
# Générer les secrets avec : openssl rand -base64 48
# ou : ./scripts/rotate-secrets.sh

# --- Secrets JWT (32 caractères minimum, DIFFÉRENTS par environnement) ---
JWT_SECRET_RECETTE=
JWT_SECRET_PREPROD=
JWT_SECRET_PROD=

# --- Comptes administrateur (mot de passe ≥ 12 caractères, unique par env) ---
ADMIN_EMAIL_RECETTE=
ADMIN_EMAIL_PREPROD=
ADMIN_EMAIL_PROD=

ADMIN_PASSWORD_RECETTE=
ADMIN_PASSWORD_PREPROD=
ADMIN_PASSWORD_PROD=

# --- URL publique (obligatoire en PROD, doit être HTTPS) ---
PUBLIC_BASE_URL_RECETTE=http://localhost:8081
PUBLIC_BASE_URL_PREPROD=http://localhost:8082
PUBLIC_BASE_URL_PROD=https://facturation.votre-domaine.fr

# --- SMTP (obligatoire hors DEV pour "mot de passe oublié") ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Optionnel ---
# TOKEN_TTL=8h
# DATA_DIR=/data
