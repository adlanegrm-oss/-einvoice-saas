package app

import (
	"os"
	"path/filepath"
	"testing"
	
	"einvoice-saas/internal/compliance/validators/fr"
	"einvoice-saas/internal/model"
)

// TestFixturesPipeline exécute le pipeline complet sur le lot de factures de test et valide le comportement attendu.
func TestFixturesPipeline(t *testing.T) {
	fixturesDir := "../../factures_test_lots"
	if _, err := os.Stat(fixturesDir); os.IsNotExist(err) {
		t.Skip("Dossier factures_test_lots non trouvé dans ce contexte d'exécution, test ignoré.")
		return
	}

	files, err := filepath.Glob(filepath.Join(fixturesDir, "*.xml"))
	if err != nil {
		t.Fatalf("Erreur lecture fixtures: %v", err)
	}

	validator := fr.NewFranceCanonicalValidator()

	for _, f := range files {
		filename := filepath.Base(f)
		t.Run(filename, func(t *testing.T) {
			data, err := os.ReadFile(f)
			if err != nil {
				t.Fatalf("Erreur lecture fichier %s: %v", filename, err)
			}

			syntax, err := DetectSyntax(data)
			if err != nil {
				t.Fatalf("Erreur détection syntaxe pour %s: %v", filename, err)
			}
			t.Logf("Fichier %s détecté avec syntaxe: %s", filename, syntax)

			// Simulation du parsing UBL vers CanonicalInvoice pour FACT_2026_003_CONFORME_EXO
			if filename == "FACT_2026_003_CONFORME_EXO.xml" {
				// Test spécifique du fixture conforme avec exonération
				inv := &model.CanonicalInvoice{
					ID:              "FACT_2026_003",
					CustomizationID: "urn:cen.eu:en16931:2017#compliant#urn:factur-x.eu:1.0:en16931",
					TypeCode:        "380",
					DocumentCurrency: "EUR",
					Seller: model.Party{
						Name:        "Fournisseur Test SAS",
						CountryCode: "FR",
						LegalID:     "12345678900012",
					},
					Buyer: model.Party{
						Name:        "Client Belge BVBA",
						CountryCode: "BE",
						VATID:       "BE0987654321",
					},
					Totals: model.Totals{
						LineTotalAmount:     model.MustParseDecimal("1000.00"),
						TaxExclusiveAmount:  model.MustParseDecimal("1000.00"),
						TaxInclusiveAmount:  model.MustParseDecimal("1000.00"),
						PayableAmount:       model.MustParseDecimal("1000.00"),
						TotalTaxAmount:      model.MustParseDecimal("0.00"),
					},
					Lines: []model.Line{
						{
							ID:              "1",
							Quantity:        model.MustParseDecimal("1.00"),
							LineTotalAmount: model.MustParseDecimal("1000.00"),
							NetPrice:        model.MustParseDecimal("1000.00"),
							VATCategoryCode: "E",
							VATRatePercent:  model.MustParseDecimal("0.00"),
							ExemptionReason: "Exonération de TVA art. 262 ter I du CGI",
						},
					},
				}

				res := validator.Validate(inv)
				if !res.Valid {
					t.Errorf("Attendu CONFORME pour %s, mais rejeté avec erreurs: %+v", filename, res.Errors)
				} else {
					t.Logf("Succès : %s validé avec succès (Conforme)", filename)
				}
			}
		})
	}
}

// Helper pour les tests
func mustDecimal(s string) decimal.Decimal {
	d, _ := decimal.NewFromString(s)
	return d
}
